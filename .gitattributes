# 统一仓库行尾为 LF，避免跨平台 CRLF 差异
* text=auto

# 源码统一 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.properties text eol=lf

# 小程序文件统一 LF
*.js text eol=lf
*.json text eol=lf
*.wxml text eol=lf
*.wxss text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.xlsx binary
