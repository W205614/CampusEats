# Copy to a protected .env.production on each CVM. Never commit real values.
SERVER_IMAGE=registry.example.com/campuseats-server@sha256:replace-with-verified-digest
WEB_IMAGE=registry.example.com/campuseats-web@sha256:replace-with-matching-digest
INSTANCE_ID=campuseats-cvm-1
WEB_BIND_ADDRESS=10.0.0.10
WEB_PORT=18083
CLB_CIDR=10.0.1.0/24
MONITOR_BIND_ADDRESS=127.0.0.1
MONITOR_PORT=19090
# Use one managed endpoint; canonical property names, no duplicates or host-specific overrides.
DB_URL=jdbc:mysql://replace-with-mysql-host:3306/sky_take_out?serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY
DB_USER=campus
MYSQL_PASSWORD=replace-with-app-password
REDIS_CONTROL_HOST=replace-with-control-redis-host
REDIS_CONTROL_PORT=6379
REDIS_CONTROL_PASSWORD=replace-with-control-password
REDIS_CONTROL_SSL=true
REDIS_CACHE_HOST=replace-with-cache-redis-host
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=replace-with-cache-password
REDIS_CACHE_SSL=true
JWT_ADMIN_SECRET=replace-with-independent-random-signing-key
BOOTSTRAP_ADMIN_PASSWORD=replace-for-first-initialization-only
ALLOWED_ORIGINS=https://campuseats.example.com
PRODUCTION_SECRETS_DIRECTORY=./.local/production-secrets
PRODUCTION_INTEGRATIONS_FILE=./.local/production/integrations.yml
PRODUCTION_CONFIG_DIRECTORY=./.local/production
JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/run/secrets/mysql-truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12
TASKS_ENABLED=true
MIGRATIONS_ENABLED=false
PUBLIC_BASE_URL=https://campuseats.example.com
WECHAT_APPID=replace-with-mini-app-id
WECHAT_SECRET=replace-with-mini-app-secret
WECHAT_MP_APPID=replace-with-official-account-app-id
WECHAT_MP_SECRET=replace-with-official-account-app-secret
WECHATPAY_MCH_ID=replace-with-service-provider-merchant-id
WECHATPAY_SERIAL=replace-with-merchant-certificate-serial
WECHATPAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay-private-key.pem
WECHATPAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay-public-key.pem
WECHATPAY_PUBLIC_KEY_ID=replace-with-wechatpay-public-key-id
WECHATPAY_API_V3_KEY=replace-with-32-byte-api-v3-key
TENCENT_SMS_SECRET_ID=replace-with-sms-secret-id
TENCENT_SMS_SECRET_KEY=replace-with-sms-secret-key
TENCENT_SMS_APP_ID=replace-with-sms-sdk-app-id
TENCENT_SMS_SIGN_NAME=replace-with-approved-sign-name
TENCENT_SMS_OTP_TEMPLATE_ID=replace-with-approved-otp-template-id
CAMPUS_STORAGE_REGION=ap-shanghai
CAMPUS_STORAGE_PRODUCT_BUCKET=replace-with-private-product-bucket
CAMPUS_STORAGE_EVIDENCE_BUCKET=replace-with-private-evidence-bucket
CAMPUS_STORAGE_SECRET_ID=replace-with-storage-secret-id
CAMPUS_STORAGE_SECRET_KEY=replace-with-storage-secret-key
POLICY_VERSION=2026-11-06-v1
OPERATOR_NAME=replace-with-actual-operator
OPERATOR_CONTACT=replace-with-actual-contact
EXTERNAL_NOTIFICATIONS_ENABLED=false
WECHAT_READY_TEMPLATE_ID=
TENCENT_SMS_READY_TEMPLATE_ID=
